# Native Linux build of the PC port (reference / "native still builds" check for web changes).
# docker build -t goldeneye-linux -f scripts/web/Dockerfile.linux scripts/web
FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config python3 libsdl2-dev zlib1g-dev libgl-dev \
    xvfb xauth mesa-utils libgl1-mesa-dri && rm -rf /var/lib/apt/lists/*
